# BEGIN Drywall Toolbox WordPress production runtime
# Physical directory: /public_html/drywalltoolbox/wp/

Options -Indexes
FileETag None

<FilesMatch "(^\.|wp-config(?:-[A-Za-z0-9._-]+)?\.php$|\.env(?:\..*)?$|composer\.(?:json|lock)$|package-lock\.json$|package\.json$|.*\.(?:bak|backup|old|orig|save|sql|sqlite|log|ini|sh|ps1|pem|key)$)">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>

<IfModule mod_rewrite.c>
RewriteEngine On
RewriteBase /wp/
RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

RewriteRule ^checkout/order-pay/(.*)$ /checkout/order-pay/$1 [R=302,L,QSA]
RewriteRule ^order-pay/(.*)$ /checkout/order-pay/$1 [R=302,L,QSA]
RewriteRule ^checkout/order-received/(.*)$ /checkout/order-received/$1 [R=302,L,QSA]

RewriteRule ^index\.php$ - [L]
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule . /wp/index.php [L]
</IfModule>

<IfModule mod_headers.c>
  Header unset ETag
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"

  <If "%{REQUEST_URI} =~ m#^/(?:wp/)?(?:wp-admin|wp-login\.php|wp-json|dtb|index\.php|wp-cron\.php|xmlrpc\.php|wc-api)(?:/|$)#i || %{REQUEST_URI} =~ m#/(?:cart|checkout|account|my-account|dashboard|orders|addresses|rewards|login|register|forgot-password|lost-password|reset-password|logout|wc-api)(?:/|$)#i || %{QUERY_STRING} =~ m#(^|&)(?:rest_route=|pay_for_order=true|order-pay=[0-9]+|wc-api=)#i || %{HTTP_COOKIE} =~ m#(?:^|;\s*)(?:wordpress_logged_in_|wordpress_sec_|wordpress_test_cookie|wp-settings-|woocommerce_cart_hash|woocommerce_items_in_cart|wp_woocommerce_session_|dtb_auth)#i">
    Header always set Cache-Control "no-store, no-cache, must-revalidate, max-age=0, private"
    Header always set Pragma "no-cache"
    Header always set Expires "0"
    Header always set X-Accel-Expires "0"
    Header always merge Vary Cookie
    Header always merge Vary Authorization
  </If>
</IfModule>

# END Drywall Toolbox WordPress production runtime
