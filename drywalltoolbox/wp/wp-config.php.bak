/**
 * Canonical site URLs.
 * Defining these in wp-config.php eliminates two DB lookups per request and
 * prevents URL hijacking via database editing. WordPress is installed in /wp/.
 *
 * NOTE: If wp-admin login breaks after deploying, verify that the `home` and
 * `siteurl` rows in the kf5_options table match these values exactly, then
 * re-upload. To recover immediately, comment both lines out so WordPress falls
 * back to the database values.
 */
define( 'WP_HOME',    'https://drywalltoolbox.com' );
define( 'WP_SITEURL', 'https://drywalltoolbox.com' );

/**
 * Production HTTPS, cookie, and admin-runtime hardening.
 *
 * The live site exposes WordPress through root-mounted /wp-admin and /wp-json
 * aliases while the WordPress files live under /wp. Woo Admin and WooPayments
 * authenticate REST calls with native WordPress auth cookies plus X-WP-Nonce,
 * so auth cookies must be valid for root /wp-json requests.
 */
if (
	( isset( $_SERVER['HTTP_X_FORWARDED_PROTO'] ) && 'https' === strtolower( (string) $_SERVER['HTTP_X_FORWARDED_PROTO'] ) )
	|| ( isset( $_SERVER['HTTP_X_FORWARDED_SSL'] ) && 'on' === strtolower( (string) $_SERVER['HTTP_X_FORWARDED_SSL'] ) )
	|| ( isset( $_SERVER['HTTP_X_FORWARDED_PORT'] ) && '443' === (string) $_SERVER['HTTP_X_FORWARDED_PORT'] )
	|| ( isset( $_SERVER['SERVER_PORT'] ) && '443' === (string) $_SERVER['SERVER_PORT'] )
) {
	$_SERVER['HTTPS'] = 'on';
}

define( 'FORCE_SSL_ADMIN', true );
define( 'COOKIEPATH', '/' );
define( 'SITECOOKIEPATH', '/' );
define( 'ADMIN_COOKIE_PATH', '/' );
define( 'COOKIE_DOMAIN', 'drywalltoolbox.com' );

define( 'DISALLOW_FILE_EDIT', true );
define( 'WP_MEMORY_LIMIT', '256M' );
define( 'WP_MAX_MEMORY_LIMIT', '512M' );

/**
 * Suppress auto-creation of WooCommerce product webhooks on every admin save.
 *
 * POLICY DECISION (2026-07-12): Set to true permanently.
 * All catalog changes go through the DTB import pipeline, not direct WP Admin
 * product editing. WooCommerce product-update webhooks are therefore not needed
 * for cache invalidation. If operators begin making live product edits via WP
 * Admin and expect immediate storefront updates, set this to false and verify
 * webhook deduplication under WooCommerce → Settings → Advanced → Webhooks.
 */
define( 'DTB_DISABLE_PRODUCT_WEBHOOKS', true );

