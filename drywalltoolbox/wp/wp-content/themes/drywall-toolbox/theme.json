{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 3,
  "settings": {
    "appearanceTools": true,
    "layout": {
      "contentSize": "760px",
      "wideSize": "1320px"
    },
    "color": {
      "custom": false,
      "customGradient": false,
      "defaultDuotone": false,
      "defaultGradients": false,
      "defaultPalette": false,
      "palette": [
        { "slug": "dtb-ink", "name": "DTB Ink", "color": "#0b0f19" },
        { "slug": "dtb-text", "name": "DTB Text", "color": "#101423" },
        { "slug": "dtb-muted", "name": "DTB Muted", "color": "#5b6273" },
        { "slug": "dtb-accent", "name": "DTB Accent", "color": "#2f6feb" },
        { "slug": "dtb-accent-dark", "name": "DTB Accent Dark", "color": "#1d4fd1" },
        { "slug": "dtb-surface", "name": "DTB Surface", "color": "#ffffff" },
        { "slug": "dtb-canvas", "name": "DTB Canvas", "color": "#f6f7f9" },
        { "slug": "dtb-border", "name": "DTB Border", "color": "#e1e5eb" },
        { "slug": "dtb-success", "name": "DTB Success", "color": "#15803d" },
        { "slug": "dtb-danger", "name": "DTB Danger", "color": "#b42318" }
      ]
    },
    "spacing": {
      "customSpacingSize": false,
      "defaultSpacingSizes": false,
      "spacingSizes": [
        { "slug": "20", "name": "2XS", "size": "0.5rem" },
        { "slug": "30", "name": "XS", "size": "0.75rem" },
        { "slug": "40", "name": "S", "size": "1rem" },
        { "slug": "50", "name": "M", "size": "1.5rem" },
        { "slug": "60", "name": "L", "size": "2rem" },
        { "slug": "70", "name": "XL", "size": "3rem" }
      ],
      "units": ["px", "rem", "%", "vw", "vh"]
    },
    "typography": {
      "customFontSize": false,
      "defaultFontSizes": false,
      "fluid": true,
      "fontFamilies": [
        {
          "slug": "dtb-system",
          "name": "DTB System",
          "fontFamily": "-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif"
        }
      ],
      "fontSizes": [
        { "slug": "small", "name": "Small", "size": "0.875rem" },
        { "slug": "medium", "name": "Medium", "size": "1rem" },
        { "slug": "large", "name": "Large", "size": "1.25rem" },
        { "slug": "x-large", "name": "Extra Large", "size": "1.625rem" }
      ]
    },
    "border": {
      "color": true,
      "radius": true,
      "style": true,
      "width": true
    }
  },
  "styles": {
    "color": {
      "background": "var:preset|color|dtb-canvas",
      "text": "var:preset|color|dtb-text"
    },
    "spacing": {
      "blockGap": "var:preset|spacing|40"
    },
    "typography": {
      "fontFamily": "var:preset|font-family|dtb-system",
      "fontSize": "var:preset|font-size|medium",
      "lineHeight": "1.5"
    },
    "elements": {
      "button": {
        "border": { "radius": "10px" },
        "color": {
          "background": "var:preset|color|dtb-accent",
          "text": "var:preset|color|dtb-surface"
        },
        "spacing": {
          "padding": {
            "top": "0.75rem",
            "right": "1.25rem",
            "bottom": "0.75rem",
            "left": "1.25rem"
          }
        },
        "typography": { "fontWeight": "600" }
      },
      "heading": {
        "color": { "text": "var:preset|color|dtb-text" },
        "typography": { "fontWeight": "650", "lineHeight": "1.2" }
      },
      "link": {
        "color": { "text": "var:preset|color|dtb-accent" }
      }
    }
  }
}
