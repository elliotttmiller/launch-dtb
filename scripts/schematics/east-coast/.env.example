# Required. Never commit a real token.
BROWSERLESS_TOKEN=

# Optional Browserless BaaS v2 endpoint.
BROWSERLESS_WS_ENDPOINT=wss://production-sfo.browserless.io

# Proxy routing. Residential is the default because East Coast product lookups
# previously returned substantial 429 throttling from a single local session.
BROWSERLESS_PROXY=residential
BROWSERLESS_PROXY_COUNTRY=us
BROWSERLESS_PROXY_STICKY=true

# Optional. Uses the Browserless /stealth CDP endpoint when true.
BROWSERLESS_STEALTH=false

# Free-compatible default; increase only within the limits of your Browserless plan.
BROWSERLESS_SESSION_TIMEOUT_MS=120000
