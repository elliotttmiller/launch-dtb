# Launch Readiness Validation Suite — environment configuration
#
# Copy to `.env` in this directory (gitignored) or export these as real
# environment variables. Only LAUNCH_SITE_URL is required; everything else
# unlocks additional stages and is otherwise skipped/warned about.

# -- Target -------------------------------------------------------------
LAUNCH_SITE_URL=https://elliottm4.sg-host.com

# -- WooCommerce REST API (Settings > Advanced > REST API; Read permission is enough) --
LAUNCH_WC_CONSUMER_KEY=
LAUNCH_WC_CONSUMER_SECRET=

# -- DTB admin operator diagnostics (WordPress Application Password) ----
LAUNCH_DTB_ADMIN_USERNAME=
LAUNCH_DTB_ADMIN_APP_PASSWORD=

# -- Stripe publishable key, used only to confirm test mode -------------
LAUNCH_STRIPE_PUBLISHABLE_KEY=

# -- Checkout simulation safety gate --------------------------------------
# Guest/registered-customer checkout stages place real orders and are
# skipped unless explicitly enabled. Never point this at production without
# LAUNCH_STRIPE_PUBLISHABLE_KEY confirming test mode — the suite refuses to
# run checkout simulation against a live (pk_live_) key regardless.
LAUNCH_ENABLE_CHECKOUT_SIMULATION=false
LAUNCH_TEST_EMAIL_DOMAIN=launch-readiness.drywalltoolbox.test
# Product path or same-origin absolute URL, e.g. /products/some-tool
LAUNCH_PRODUCT_URL_PATH=

# -- Browser automation ---------------------------------------------------
LAUNCH_HEADLESS=true
LAUNCH_BROWSER_TIMEOUT_MS=30000
LAUNCH_SLOW_MO_MS=0

# -- Integration sync polling ----------------------------------------------
LAUNCH_SYNC_POLL_TIMEOUT_S=90
LAUNCH_SYNC_POLL_INTERVAL_S=5
LAUNCH_SKIP_INTEGRATION_CHECKS=false
