# Drywall Toolbox SiteGround FTPES deployment.
# Copy this file to .env and keep .env local. Never commit real credentials.

DTB_FTP_PASSWORD=<siteground-ftp-account-password>

# FTP accounts may be chrooted to public_html or to a parent directory.
# Use / only when the account opens directly at public_html and contains wp/.
DTB_FTP_ROOT=/
