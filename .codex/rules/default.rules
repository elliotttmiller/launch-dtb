# DTB project-local command guardrails.
# These rules govern commands requesting execution outside the sandbox.

prefix_rule(
    pattern = ["git", "push", ["--force", "-f"]],
    decision = "forbidden",
    justification = "Force-pushing can rewrite shared history. Use a normal push or an explicitly reviewed repository workflow.",
    match = ["git push --force", "git push -f origin main"],
    not_match = ["git push origin feature/codex"],
)

prefix_rule(
    pattern = ["git", "reset", "--hard"],
    decision = "forbidden",
    justification = "Hard reset can destroy uncommitted work. Inspect status/diff and use a scoped non-destructive recovery instead.",
    match = ["git reset --hard", "git reset --hard HEAD~1"],
)

prefix_rule(
    pattern = ["rm", "-rf"],
    decision = "forbidden",
    justification = "Recursive force deletion is too broad for project automation. Use a bounded, reviewed deletion command instead.",
    match = ["rm -rf .", "rm -rf node_modules"],
)

prefix_rule(
    pattern = ["wp", "db", ["reset", "clean", "drop"]],
    decision = "forbidden",
    justification = "Database-destructive WP-CLI operations are prohibited from routine Codex workflows. Use an explicit operator-reviewed migration/recovery procedure.",
    match = ["wp db reset", "wp db clean", "wp db drop"],
    not_match = ["wp db check", "wp db query SELECT 1"],
)

prefix_rule(
    pattern = ["git", "push"],
    decision = "prompt",
    justification = "Publishing repository history is an external side effect and should be explicitly reviewed.",
    match = ["git push", "git push origin feature/codex"],
)

prefix_rule(
    pattern = ["gh", "pr", ["create", "merge", "close"]],
    decision = "prompt",
    justification = "Pull-request publication or state changes are external repository mutations and should be explicitly reviewed.",
    match = ["gh pr create --fill", "gh pr merge 42", "gh pr close 42"],
    not_match = ["gh pr view 42", "gh pr list"],
)
