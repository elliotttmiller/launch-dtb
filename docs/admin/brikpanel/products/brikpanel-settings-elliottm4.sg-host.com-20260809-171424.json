        "brikpanel_custom_css": "/* Fix: dtb-global-quick-nav overlapping the sidebar/content.\r\n   BrikPanel's whole layout reads from --bp-topbar-height (sidebar top,\r\n   content padding-top, toasts, mobile backdrop). Bumping it here pushes\r\n   everything down together to make room for the added quick-nav row. */\r\nhtml.brikpanel-has-topbar {\r\n    --bp-topbar-height: 96px;\r\n}\r\n\r\n/* Keep the original single-row height for the primary bar so it doesn't\r\n   stretch to fill the new taller box — the quick-nav row takes the rest. */\r\n.brikpanel-topbar-inner {\r\n    height: 52px;\r\n    flex: 0 0 auto;\r\n}\r\n\r\n#dtb-global-quick-nav {\r\n    box-sizing: border-box;\r\n    min-height: 44px;\r\n    padding: 0 1rem;\r\n    border-top: 1px solid var(--bp-topbar-border, #e3e3e3);\r\n    overflow-x: auto;\r\n    overflow-y: hidden;\r\n}",
